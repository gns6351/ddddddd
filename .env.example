# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 GitHub에 올라가지 않습니다.

# Gemini API 키 (Google AI Studio). 비워 두면 모의(mock) 모드로 동작
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 변환 점검(의미 반전·내용 추가) 모델. 같은 모델은 자기 출력을 관대하게 볼 수 있어 다른 모델 권장. 비우면 GEMINI_MODEL과 같음
CHECK_MODEL=
# 페르소나 샘플 생성·오류 주입 모델. 변환·점검과 다른 모델 권장. 비우면 GEMINI_MODEL과 같음
GEN_MODEL=
# 추론 강도: low / medium / high. 모델이 지원하지 않으면 자동으로 빼고 보냄. 비우면 모델 기본값
GEMINI_THINKING_LEVEL=low
# 응답 지연 기준(호출 1회, ms). 넘으면 실패 경로. 파일럿에서 정함
LLM_TIMEOUT_MS=15000
# live: 실제 호출 / mock: 가짜 응답 (비워 두면 키가 있을 때 live)
LLM_MODE=

# 연구자 화면 비밀번호. 비워 두면 서버 PC(localhost)에서만 비밀번호 없이 열림
ADMIN_TOKEN=
# 인터넷 링크로 참가자를 받을 때 입장 코드 (링크에 ?code=값). 비우면 누구나 시작 가능
ACCESS_CODE=

# 비워 두면 3000부터 빈 포트를 찾아 씀
PORT=
# 새 세션의 단계 표시: pilot(파일럿, 본 분석 제외) / main(본실험). 대시보드에서 세션별로 바꿀 수 있음
STUDY_PHASE=pilot

# 데이터 폴더. 자체 테스트와 본 실험을 나누려면 data-selftest 처럼 바꿔서 실행
DATA_DIR=data
# 프롬프트 버전 (content/prompts/transform/<버전>.md, content/prompts/check/<버전>.md)
TRANSFORM_PROMPT=v4
CHECK_PROMPT=v1
PERSONA_PROMPT=v1
INJECT_PROMPT=v1
