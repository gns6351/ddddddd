{
  "version": "game-safety-v1",
  "_note": "게임 위험 규칙(FR-10). 걱정 입력과 매 턴 발화에 적용한다. 정규식(JavaScript u 플래그), 원문(NFKC)과 공백 뺀 문장 둘 다에 적용. state = 위험한 상태를 직접 표현(본인), harm = 위험한 행동 권유, blame = 비난(조언 판정에서만 쓰고 역할극은 멈추지 않음). 간접 표현은 AI 판정이 맡는다.",
  "state": [
    { "id": "s01-suicidal", "pattern": "죽고\\s*싶|자살(?!\\s*예방)|목숨을?\\s*끊|극단적(인)?\\s*(선택|생각)|살고\\s*싶지\\s*않|사라지고\\s*싶|없어지고\\s*싶|죽어\\s*버리고\\s*싶|죽을\\s*(거|것)\\s*같아서\\s*(무섭|겁)" },
    { "id": "s02-self-harm", "pattern": "자해|손목을?\\s*(긋|그었)|(내|제)\\s*몸을?\\s*(해치|다치게)" },
    { "id": "s03-plan-means", "pattern": "유서|뛰어내리(려|고\\s*싶|겠|기로)|약을?\\s*(모아|모으|잔뜩|한꺼번에)" },
    { "id": "s04-harm-others", "pattern": "죽여\\s*버리|죽이고\\s*싶|해치고\\s*싶|가만두지\\s*않겠" },
    { "id": "s05-help", "pattern": "(저|나)\\s*좀\\s*(도와|살려)\\s*(주세요|줘)|지금\\s*너무\\s*위험해" }
  ],
  "harm": [
    { "id": "h01-self-harm-advice", "pattern": "죽어\\s*버려|죽는\\s*게\\s*나아|자해\\s*해|사라져\\s*버려|뛰어내려" },
    { "id": "h02-dangerous", "pattern": "음주\\s*운전|술\\s*(잔뜩\\s*)?마시고\\s*운전|약을?\\s*(왕창|잔뜩)\\s*(먹|삼켜)|굶어\\s*버려" },
    { "id": "h03-violence", "pattern": "때려\\s*(버려|줘)|패\\s*버려|해코지\\s*해" }
